{
  "name": "noon-store-login",
  "version": "4.2.2",
  "private": true,
  "description": "Monitor and keep alive authenticated Noon store Chrome sessions",
  "type": "commonjs",
  "bin": "dist/src/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "package:win": "npm run build && node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@yao-pkg/pkg": "^6.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "scripts": [
      "dist/src/**/*.js"
    ],
    "outputPath": "release"
  }
}
